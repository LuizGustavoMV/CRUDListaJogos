<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="760.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.template.controller.MainController">
   <children>
      <VBox spacing="12.0" style="-fx-background-color: #4d7ea8;"
            AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0"
            AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="18.0" left="24.0" right="24.0" top="18.0" />
         </padding>
         <children>
            <Label text="Registre Seus Jogos" textFill="#e8e9eb">
               <font>
                  <Font name="New Peninim MT" size="20.0" />
               </font>
            </Label>

            <GridPane hgap="10.0" vgap="8.0">
               <columnConstraints>
                  <ColumnConstraints halignment="RIGHT" minWidth="70.0" prefWidth="105.0" />
                  <ColumnConstraints hgrow="ALWAYS" minWidth="100.0" />
                  <ColumnConstraints halignment="RIGHT" minWidth="85.0" prefWidth="105.0" />
                  <ColumnConstraints hgrow="ALWAYS" minWidth="100.0" />
               </columnConstraints>
               <children>
                  <Label text="ID" textFill="#e8e9eb" />
                  <TextField fx:id="txtId" editable="false" maxWidth="Infinity"
                             promptText="Selecione na tabela" GridPane.columnIndex="1" />

                  <Label text="Nome do jogo" textFill="#e8e9eb" GridPane.rowIndex="1" />
                  <TextField fx:id="txtNome" maxWidth="Infinity"
                             GridPane.columnIndex="1" GridPane.rowIndex="1" />

                  <Label text="Gênero" textFill="#e8e9eb" GridPane.rowIndex="2" />
                  <TextField fx:id="txtGenero" maxWidth="Infinity"
                             GridPane.columnIndex="1" GridPane.rowIndex="2" />

                  <Label text="Plataforma" textFill="#e8e9eb" GridPane.columnIndex="2" />
                  <TextField fx:id="txtPlataforma" maxWidth="Infinity"
                             GridPane.columnIndex="3" />

                  <Label text="Preço do jogo" textFill="#e8e9eb" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                  <TextField fx:id="txtPreco" maxWidth="Infinity" promptText="Ex.: 150,00"
                             GridPane.columnIndex="3" GridPane.rowIndex="1" />
               </children>
            </GridPane>

            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button fx:id="btnCadastrar" mnemonicParsing="false"
                          onAction="#btnCadastrarAction" prefWidth="100.0"
                          style="-fx-background-color: #272932;"
                          text="Cadastrar" textFill="#e8e9eb" />
                  <Button fx:id="btnSalvar" mnemonicParsing="false"
                          onAction="#btnSalvarAction" prefWidth="100.0"
                          style="-fx-background-color: #198754;"
                          text="Salvar" textFill="#e8e9eb" />
                  <Button fx:id="btnDeletar" mnemonicParsing="false"
                          onAction="#btnDeletarAction" prefWidth="100.0"
                          style="-fx-background-color: #dc3545;"
                          text="Deletar" textFill="#e8e9eb" />
                  <Button fx:id="btnLimpar" mnemonicParsing="false"
                          onAction="#btnLimparAction" prefWidth="100.0"
                          text="Limpar" />
               </children>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label text="Buscar por nome:" textFill="#e8e9eb" />
                  <TextField fx:id="txtBusca" maxWidth="Infinity"
                             onKeyReleased="#filtrarJogos"
                             promptText="Digite o nome do jogo"
                             HBox.hgrow="ALWAYS" />
               </children>
            </HBox>

            <TableView fx:id="tabelaJogos" minHeight="150.0"
                       onMouseClicked="#carregarCampos"
                       VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colId" minWidth="45.0" prefWidth="60.0"
                               text="ID" />
                  <TableColumn fx:id="colNome" minWidth="100.0" prefWidth="180.0"
                               text="Nome" />
                  <TableColumn fx:id="colGenero" minWidth="90.0" prefWidth="130.0"
                               text="Gênero" />
                  <TableColumn fx:id="colPlataforma" minWidth="90.0" prefWidth="130.0"
                               text="Plataforma" />
                  <TableColumn fx:id="colPreco" minWidth="80.0" prefWidth="100.0"
                               text="Preço" />
               </columns>
            </TableView>

            <Label fx:id="lblMensagem" minHeight="24.0" prefHeight="24.0"
                   text="Sistema inicializado com sucesso."
                   textFill="#a3e635" wrapText="true" />
         </children>
      </VBox>
   </children>
</AnchorPane>
